# nexus-gateway - settings for `wrangler dev` ONLY. Copy to `.dev.vars` (gitignored):
#   cp .dev.vars.example .dev.vars && npx wrangler dev
# Then open http://localhost:8787/admin and sign in with the password: local-dev-password
#
# For a real deployment do not use this file: run `node scripts/deploy.mjs` (see README),
# which generates strong secrets itself. These values are public examples; never reuse them.
#
# Provider API keys (NVIDIA, Groq, ...) do not go here. Paste them in the console
# (Providers tab). A key set as a secret or in this file wins over one entered
# in the console.
#
# Do not leave a name here with an empty value: it would override the value in wrangler.toml
# with an empty string. Delete or comment out what you do not use.

NEXUS_MASTER_KEY=dev-master-key-not-for-production
ADMIN_SESSION_SECRET=dev-session-secret-not-for-production
ADMIN_PASSWORD_HASH=pbkdf2-sha256$100000$3UCR-XioryE0Evk0kTgQrw$yptV8EKxttnIzXjkhMbcKG8XprKKUZmXEAEpCapSV8s

# -- Cloudflare AI Gateway ------------------------------------------------------------
# Taken from wrangler.toml. Uncomment only to override it for local dev. Every request
# goes out through AI Gateway, so wrangler.toml needs both values for chat to work.
# CF_ACCOUNT_ID=
# AIG_GATEWAY_ID=

# -- Google sign-in (optional) --------------------------------------------------------
# GOOGLE_CLIENT_ID and OPERATOR_EMAILS are plain vars in wrangler.toml. Add the secret
# here, and http://localhost:8787/oauth/google/callback to the OAuth client.
# GOOGLE_CLIENT_SECRET=

# -- Optional -------------------------------------------------------------------------
# Encrypts console-stored provider keys instead of NEXUS_MASTER_KEY, so the master key can
# be rotated without losing them.
# KEY_ENCRYPTION_SECRET=
# Only if your Anthropic key is not workspace-scoped.
# ANTHROPIC_WORKSPACE_ID=

# Optional: a Cloudflare token with ONLY "AI Gateway: Edit". Lets the console register
# custom providers in AI Gateway when you add one.
# AIG_API_TOKEN=
